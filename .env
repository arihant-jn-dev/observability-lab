# =============================================================================
# PORT MAP -- single source of truth
# =============================================================================
# Every host port the lab binds is declared here so you can see the whole map in
# one place and change any of it without hunting through docker-compose.yml.
#
# AVOIDED ON PURPOSE (already in use on this machine):
#   3000, 3001  -- your other project
#   4000        -- your other project
#   5432        -- your pgvector container
#   6379        -- a Redis already running on your host
#   3306/33060  -- MySQL
# -----------------------------------------------------------------------------

# --- application ---
ORDERS_API_PORT=8080
PAYMENTS_API_PORT=8081

# --- datastores ---
POSTGRES_PORT=5433
REDIS_PORT=6380

# --- telemetry pipeline (stage 2+) ---
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
COLLECTOR_METRICS_PORT=8889

# --- backends (stage 2-4) ---
PROMETHEUS_PORT=9090
TEMPO_PORT=3210
LOKI_PORT=3110
GRAFANA_PORT=3300

# --- infra exporters (stage 5) ---
CADVISOR_PORT=8083
NODE_EXPORTER_PORT=9100
POSTGRES_EXPORTER_PORT=9187
REDIS_EXPORTER_PORT=9121
ALLOY_PORT=12345

# --- credentials (lab only -- never do this for real) ---
POSTGRES_USER=lab
POSTGRES_PASSWORD=lab
POSTGRES_DB=ordersdb
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
